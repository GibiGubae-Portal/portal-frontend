# Optional. Leave empty to call the API on the same origin (/api), which
# vercel.json rewrites to the backend. Only set this to call a backend on a
# different origin directly (requires SameSite=None cookies on that backend).
VITE_API_URL=

# Dev only: where `npm run dev` proxies /api (default http://localhost:5500).
VITE_DEV_API_PROXY=http://localhost:5500
